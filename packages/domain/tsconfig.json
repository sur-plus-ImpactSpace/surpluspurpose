{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true
  },
  "include": ["src/**/*.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "src/**/* [0-9].ts",
    "* [0-9].ts",
    "src/**/* 2.ts",
    "src/**/* 3.ts",
    "src/**/* 4.ts",
    "src/**/* 5.ts",
    "src/**/* 6.ts",
    "src/**/* 7.ts",
    "src/**/* 8.ts",
    "src/**/* 9.ts",
    "* 2.ts",
    "* 3.ts",
    "* 4.ts",
    "* 5.ts",
    "* 6.ts",
    "* 7.ts",
    "* 8.ts",
    "* 9.ts"
  ]
}
