# Copy to apps/web/.env.local (gitignored) and fill in. Server-side values are 
# never exposed to the browser. Every feature below turns on with its own keys;
# without them it stays off (payments and e-signature fail closed).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key, server only>

# --- Access you choose yourself ---
SURPLUS_ADMIN_BOOTSTRAP_TOKEN=<long random value>
SURPLUS_DEMO_ACCESS_TOKEN=<long random value; the demo is closed without it on a real deployment>
# SURPLUS_ALLOW_PREVIEW_MUTATIONS=true   # only for a demo-only deployment

# --- Card payments: Stripe (docs/ops/payments-runbook.md) ---
STRIPE_SECRET_KEY=<sk_test_... or sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_..., from the webhook endpoint in Stripe>
STRIPE_PRICE_SEED=<price_...>
STRIPE_PRICE_TREE=<price_...>

# --- E-signature: DocuSeal (docs/ops/esignature-runbook.md) ---
DOCUSEAL_API_KEY=<DocuSeal API key>
DOCUSEAL_WEBHOOK_SECRET=<value of the custom header you set in DocuSeal>
# DOCUSEAL_URL=https://api.docuseal.eu     # EU or self-hosted; default is api.docuseal.com
# DOCUSEAL_WEBHOOK_HEADER=x-docuseal-secret
# DOCUSEAL_FILE_HOSTS=files.example.org    # self-hosted only

# --- Email for invitations ---
RESEND_API_KEY=<re_...>

# --- Captcha (only if Turnstile is enabled in Supabase Auth) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>

# Webhook URLs to register at the providers (replace the domain):
#   Stripe:   https://<your-domain>/api/stripe/webhook      (event: checkout.session.completed)
#   DocuSeal: https://<your-domain>/api/webhooks/docuseal   (custom header: x-docuseal-secret)
